{
  "name": "aurazone-v2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:generate": "dotenv -e .env -- pnpm --filter @aurazone/database db:generate",
    "db:push": "dotenv -e .env -- pnpm --filter @aurazone/database exec prisma db push",
    "db:migrate": "dotenv -e .env -- pnpm --filter @aurazone/database db:migrate",
    "db:migrate:dev": "dotenv -e .env -- pnpm --filter @aurazone/database run db:migrate:dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @aurazone/database db:seed",
    "db:reset": "dotenv -e .env -- pnpm --filter @aurazone/database exec prisma migrate reset",
    "db:studio": "dotenv -e .env -- pnpm --filter @aurazone/database db:studio",
    "test:e2e": "pnpm --filter @aurazone/automation test",
    "test:e2e:api": "pnpm --filter @aurazone/automation test:api",
    "test:e2e:api:admin": "pnpm --filter @aurazone/automation test:api:admin",
    "test:e2e:web": "pnpm --filter @aurazone/automation test:web",
    "test:e2e:mobile": "pnpm --filter @aurazone/automation test:mobile-native",
    "test:e2e:report": "pnpm --filter @aurazone/automation report"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.5.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}